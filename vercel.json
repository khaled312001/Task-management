{
  "version": 2,
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3",
      "config": {
        "memory": 1024,
        "maxDuration": 60
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:CAhzfprlCIzf0HRNUpQngs37jpa8KqeaOru4v/NnXvs=",
    "APP_URL": "https://task-management-rose-seven.vercel.app",
    "APP_LOCALE": "ar",
    "APP_FALLBACK_LOCALE": "en",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "srv2070.hstgr.io",
    "DB_PORT": "3306",
    "DB_DATABASE": "u492425110_tasks",
    "DB_USERNAME": "u492425110_tasks",
    "DB_PASSWORD": "3Z3QV7/a~D9",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "10080",
    "SESSION_ENCRYPT": "true",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAME_SITE": "lax",
    "CACHE_STORE": "array",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "local",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",
    "BCRYPT_ROUNDS": "10"
  }
}
